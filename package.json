{
  "name": "ttc-marketing-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:ui && next dev",
    "build": "npm run build:ui && next build",
    "start": "next start",
    "build:ui": "node scripts/build-studio-ui.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build:ui && node --conditions=react-server --import tsx --test --test-timeout=200000 tests/unit.test.ts tests/planner.test.ts tests/ugc.test.ts tests/integration.test.ts",
    "import:artifact": "tsx --env-file=.env.local --conditions=react-server scripts/import-artifact-export.ts",
    "test:db": "bash supabase/run-db-tests.sh"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "pg": "^8.23.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}